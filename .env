# Committed, non-secret defaults. Machine-specific / real values go in
# .env.local, which is gitignored and WINS: server/bootEnv.ts loads .env.local
# first and dotenv never overwrites a key that is already set.

# Dev ports. Chosen to not collide with any other project on this machine:
#   new_plex 3001/5174 (prod 3002/5175), theerp 3004/3005,
#   apply-for-me 4000/4173, forge-gym 6100/6101, and Vite's own default 5173.
#   3011/5181 are held in reserve for a future production pair.
SERVER_PORT=3010
VITE_PORT=5180

# Local Homebrew PostgreSQL 18, trust auth on localhost, no password.
# Create the database once with: createdb easy_test_dev
DATABASE_URL=postgresql://khalah@localhost:5432/easy_test_dev?schema=public

# Where the Playwright controller writes screenshot PNGs (and serves them
# from). Relative paths resolve against the project root. /screenshots/ is
# gitignored.
SCREENSHOT_DIR=screenshots
