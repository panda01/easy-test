// Prisma 7 datasource blocks carry ONLY the provider. The connection string is
// supplied by the project-root `prisma.config.ts` (`datasource.url`), which
// reads DATABASE_URL after `server/bootEnv.ts` has loaded .env.local / .env.
// This matches what `prisma init` itself generates on Prisma 7.
datasource db {
  provider = "postgresql"
}

// `prisma-client` (NOT the legacy `prisma-client-js`) is the Prisma 7 ESM
// generator: it emits TypeScript sources into `output` instead of writing into
// node_modules. `output` is relative to THIS file, so the client lands at
// `server/generated/prisma/`. Never import from there in app code - go through
// `../services/dbService.ts`. See `./README.md`.
//
// `partialIndexes` is a PREVIEW feature. It is what lets `Website.url` be
// unique among ACTIVE (not soft-deleted) websites only - see the
// `@@unique(..., where: ...)` on `Website` below.
generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

/// A website a user wants to test.
///
/// Field names are intentionally camelCase and are the names app code uses.
/// Only the TABLE name is mapped, to the snake_case plural this project uses
/// for tables. Because the fields are not individually @map'd, Postgres stores
/// them as quoted mixed-case columns - hand-written SQL must quote them:
///   select "createdAt" from websites;
///
/// Rows are SOFT deleted: deleting sets `deletedAt` (and sets the same
/// timestamp on the website's active use cases, actions, screenshot runs,
/// action scripts, action script runs, crawl runs, crawled pages, and
/// credentials) instead of removing the row. Every dbService query filters
/// `deletedAt: null`.
///
/// Two per-website settings control WHEN the Playwright controller takes a
/// screenshot, after the page's `load` event:
/// - `networkIdleTimeoutMs`: how long to wait for network requests to finish
///   (Playwright's "networkidle"). If they are still running when it runs out,
///   the screenshot is taken immediately. 0 means "don't wait for idle".
/// - `screenshotMinimumWaitMs`: a FLOOR on the time from `load` to the
///   screenshot. After idle + paint, only the remainder (if any) is waited.
/// Both are whole milliseconds from 0 to 30000, and the cap may not be lower
/// than the minimum (enforced by `validateWebsiteInput`).
///
/// `loginUrl` is the website's login page. Null means the website does not
/// require login. Its credentials inherit it (a credential may override it
/// with its own `loginUrl`). When it is null and a crawl logs in successfully
/// with a credential's own login URL, the website LEARNS it: that URL is
/// saved here (`adoptWebsiteLoginUrl`), never overwriting one already set.
model Website {
  id                      String            @id @default(cuid())
  url                     String
  name                    String
  description             String?
  networkIdleTimeoutMs    Int               @default(5000)
  screenshotMinimumWaitMs Int               @default(1)
  loginUrl                String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?
  useCases                UseCase[]
  actions                 Action[]
  screenshotRuns          ScreenshotRun[]
  actionScripts           ActionScript[]
  actionScriptRuns        ActionScriptRun[]
  crawlRuns               CrawlRun[]
  crawledPages            CrawledPage[]
  credentials             Credential[]

  // Partial unique index: a URL may appear on any number of soft-deleted rows
  // but on at most one active row, so a deleted website's URL can be re-added.
  @@unique([url], where: { deletedAt: null })
  @@map("websites")
}

/// A scenario to test on a website, e.g. "Sign up and create a project".
/// Belongs to exactly one website. Soft deleted like `Website`.
model UseCase {
  id          String    @id @default(cuid())
  websiteId   String
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  website     Website   @relation(fields: [websiteId], references: [id])

  @@index([websiteId])
  @@map("use_cases")
}

/// A reusable step on a website, e.g. "Log in". Belongs to exactly one
/// website. Soft deleted like `Website`; deleting an action also stamps the
/// same `deletedAt` on its active scripts and script runs.
model Action {
  id          String            @id @default(cuid())
  websiteId   String
  title       String
  description String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  website     Website           @relation(fields: [websiteId], references: [id])
  scripts     ActionScript[]
  scriptRuns  ActionScriptRun[]

  @@index([websiteId])
  @@map("actions")
}

/// One visit the Playwright controller made to a website: a headless browser
/// loaded the URL, and (when the page answered at all) a viewport screenshot
/// was written to disk. Belongs to exactly one website. Soft deleted like
/// `Website`, and soft deleted together with it.
///
/// `requestedUrl` is a snapshot of the website's URL at run time, because the
/// website's URL can be edited afterwards.
///
/// `succeeded` is true only when navigation completed AND the page answered
/// with an HTTP status below 400. A 404/500 page is a failed run that still
/// has a screenshot; a DNS error, refused connection, or timeout is a failed
/// run with `screenshotFileName` null.
///
/// `screenshotFileName` is RELATIVE to the configured screenshot directory
/// (`SCREENSHOT_DIR`), e.g. `<websiteId>/<uuid>.png`, so moving the directory
/// or the repo does not break stored rows.
///
/// `durationMs` measures the navigation only (not browser launch or the
/// screenshot itself).
model ScreenshotRun {
  id                 String    @id @default(cuid())
  websiteId          String
  requestedUrl       String
  succeeded          Boolean
  httpStatus         Int?
  errorMessage       String?
  screenshotFileName String?
  durationMs         Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  website            Website   @relation(fields: [websiteId], references: [id])

  @@index([websiteId])
  @@map("screenshot_runs")
}

/// A Playwright script Claude generated from an action ("Convert to script").
/// Belongs to exactly one action (and, denormalized, its website).
///
/// IMMUTABLE: rows are create-only - dbService has no update function for them
/// and there is no PUT route. Converting the same action again creates a NEW
/// row; the UI numbers them "Version 1, 2, ..." by `createdAt`. Soft deleted
/// only together with its action or its website (same `deletedAt`).
///
/// `websiteName`, `startUrl`, `actionTitle`, and `actionDescription` are
/// snapshots of exactly what was sent to Claude, because the website and the
/// action can be edited afterwards. `startUrl` is the website URL the script's
/// `START_URL` constant was told to use.
///
/// `code` is the complete `.mjs` source, run verbatim with `node`.
/// `ruleViolations` is the warn-only text scan of `code` for features a real
/// user could not use (e.g. "Line 14: .fill( - ..."); empty when clean.
/// `modelId` is the model that actually answered (`response.model`) - the
/// model chosen in the UI, or its fallback when the chosen one declined.
/// `effort` is the effort level sent with the request (`low`, `medium`,
/// `high`, `xhigh`, or `max`); a fallback inherits it. Null means "Standard"
/// (the chosen model has no effort setting) - and also marks rows saved before
/// this column existed.
model ActionScript {
  id                String            @id @default(cuid())
  websiteId         String
  actionId          String
  websiteName       String
  startUrl          String
  actionTitle       String
  actionDescription String
  summary           String
  assumptions       String[]
  code              String
  ruleViolations    String[]
  modelId           String
  effort            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  website           Website           @relation(fields: [websiteId], references: [id])
  action            Action            @relation(fields: [actionId], references: [id])
  runs              ActionScriptRun[]

  @@index([websiteId])
  @@index([actionId])
  @@map("action_scripts")
}

/// One "Run script": the stored `ActionScript.code` was written to
/// `<ACTION_SCRIPT_DIR>/<websiteId>/<uuid>/script.mjs` and run with `node`
/// (a visible browser window). Create-only, like the script it ran. Soft
/// deleted together with its action or website.
///
/// `succeeded` is true only when the process exited with code 0, was not
/// stopped by the time limit, AND wrote no `failure.png` (the template only
/// writes it from its `catch`). `exitCode` is null when the process was
/// killed by a signal, which `exitSignal` then names. `timedOut` is true when
/// the run hit the time limit and was stopped.
///
/// `output` is the combined stdout + stderr (the template's step log), capped;
/// when the cap cut it, the EARLY part was dropped and `outputWasTruncated` is
/// true. `failureScreenshotFileName` is RELATIVE to `ACTION_SCRIPT_DIR`, e.g.
/// `<websiteId>/<uuid>/failure.png`, or null when none was written.
/// `durationMs` runs from process start to process end.
model ActionScriptRun {
  id                        String       @id @default(cuid())
  websiteId                 String
  actionId                  String
  actionScriptId            String
  succeeded                 Boolean
  exitCode                  Int?
  exitSignal                String?
  timedOut                  Boolean
  output                    String
  outputWasTruncated        Boolean
  failureScreenshotFileName String?
  durationMs                Int
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  deletedAt                 DateTime?
  website                   Website      @relation(fields: [websiteId], references: [id])
  action                    Action       @relation(fields: [actionId], references: [id])
  actionScript              ActionScript @relation(fields: [actionScriptId], references: [id])

  @@index([websiteId])
  @@index([actionId])
  @@index([actionScriptId])
  @@map("action_script_runs")
}

/// One crawl of a website: a headless browser on this machine started at the
/// website's URL, followed every same-origin `<a href>` it found (links only -
/// it never clicks buttons), and recorded each page it reached as a
/// `CrawledPage`. Belongs to exactly one website. Soft deleted together with
/// it.
///
/// The crawl runs in the BACKGROUND: the row is created with
/// `status: "running"`, pages are added (and the two counters updated) as they
/// are visited, and the row is finished when the crawl ends. `status` is one
/// of:
/// - `running`: still crawling.
/// - `finished`: every reachable page was visited.
/// - `stoppedAtPageLimit`: `pageLimit` pages were visited with links still
///   waiting.
/// - `stoppedAtTimeLimit`: the crawl's time limit ran out with links waiting.
/// - `failed`: the crawl itself broke (e.g. the browser could not launch), or
///   it could not log in with its credential; `errorMessage` says why. A page
///   that 404s is NOT a failed crawl.
/// - `interrupted`: the server restarted while it was running - either the
///   crawl saw its browser close (Playwright closes it on SIGTERM) and
///   stopped, or the next boot found the run still `running`.
///
/// `startUrl` is a snapshot of the website's URL at crawl time. `pageLimit` is
/// the cap the crawl ran with. `visitedPageCount` and `waitingUrlCount` are the
/// live progress counters (pages recorded so far, links queued but not yet
/// visited). `durationMs` and `finishedAt` are null while the crawl runs.
///
/// LOGGING IN: `credentialId` is the credential chosen when the crawl was
/// started, or null for a crawl as a logged-out visitor. With a credential,
/// the crawler logs in FIRST and records no page until that succeeds:
/// - while it logs in the run is `running` with 0 pages and
///   `isLoggedIn: false`;
/// - once the login succeeds `isLoggedIn` turns true, BEFORE the first page
///   is recorded - so every page of a run with `isLoggedIn: true` was viewed
///   logged in as that credential;
/// - when the login fails the run ends `failed` (`errorMessage` says why),
///   keeps its `credentialId`, and has no pages. What the browser showed at
///   that moment is saved as a PNG: `loginFailureScreenshotFileName` is its
///   path RELATIVE to the screenshot directory (`SCREENSHOT_DIR`), e.g.
///   `<websiteId>/<uuid>.png`, or null when there is none (the login did not
///   fail, or the screenshot could not be taken).
/// A run without a credential always has `isLoggedIn: false`.
///
/// BUTTONS: `buttonMode` is which buttons the crawl clicks on each page, on top
/// of following its links - `linksOnly` (none), `allButRisky` (every labelled
/// button except risky ones: create, delete, update, logout, pay, confirm,
/// ...), or `openOnly` (only "open" buttons). A click only counts when it
/// lands on a different page of the same site; that page is then crawled like
/// a link (see `CrawledPage.foundByButtonText` and `buttonUrls`).
model CrawlRun {
  id                             String        @id @default(cuid())
  websiteId                      String
  credentialId                   String?
  isLoggedIn                     Boolean       @default(false)
  buttonMode                     String        @default("linksOnly")
  startUrl                       String
  status                         String
  pageLimit                      Int
  visitedPageCount               Int           @default(0)
  waitingUrlCount                Int           @default(0)
  errorMessage                   String?
  loginFailureScreenshotFileName String?
  durationMs                     Int?
  finishedAt                     DateTime?
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt
  deletedAt                      DateTime?
  website                        Website       @relation(fields: [websiteId], references: [id])
  credential                     Credential?   @relation(fields: [credentialId], references: [id])
  pages                          CrawledPage[]

  @@index([websiteId])
  @@index([credentialId])
  @@map("crawl_runs")
}

/// One page a crawl visited. Belongs to exactly one crawl run (and,
/// denormalized, its website). Create-only; soft deleted together with its
/// website.
///
/// The pages of a run form a TREE: `parentPageId` points at the page where
/// this page's link was first found, and is null only for the start page.
/// `linkedUrls` holds every same-origin link found on the page (normalized),
/// so the full link graph is kept too, not just the tree.
///
/// Three URLs are kept:
/// - `url`: the page's identity within the run - origin + path, with the
///   query string and hash dropped. Unique per run. It is WHERE THE BROWSER
///   LANDED: a link to `/` that redirects to `/calendar` is recorded as
///   `/calendar`. The one exception: when the page it landed on is already
///   recorded in this run, the page is recorded under the URL it was
///   requested at instead (no duplicate rows), and `finalUrl` names the page
///   it landed on.
/// - `requestedUrl`: what the browser actually loaded - the first link that
///   reached the page, hash dropped (the query string is kept).
/// - `finalUrl`: where the browser ended up after redirects (HTTP 3xx) and
///   client-side navigation.
///
/// `wasRedirected` is true when the browser landed on a different page
/// (origin + path) than the one it requested - a server redirect or a
/// client-side one alike.
///
/// Buttons (when the run's `buttonMode` clicks them): `buttonUrls` holds the
/// same-site pages (identities) this page's buttons led to, in click order,
/// alongside `linkedUrls`. `foundByButtonText` is the text of the button whose
/// click first led to THIS page, or null when a link (or the start URL) did.
///
/// `visitOrder` counts from 0 in the order pages were visited (breadth first),
/// and `depth` is the number of links followed from the start page.
/// `succeeded` is true only when navigation completed, the page answered below
/// HTTP 400, AND its aria snapshot was taken. `ariaSnapshot` is Playwright's
/// YAML aria snapshot of `<body>`, or null when it could not be taken.
model CrawledPage {
  id                String        @id @default(cuid())
  crawlRunId        String
  websiteId         String
  parentPageId      String?
  url               String
  requestedUrl      String
  finalUrl          String
  wasRedirected     Boolean       @default(false)
  visitOrder        Int
  depth             Int
  succeeded         Boolean
  httpStatus        Int?
  errorMessage      String?
  title             String?
  ariaSnapshot      String?
  linkedUrls        String[]
  buttonUrls        String[]      @default([])
  foundByButtonText String?
  durationMs        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  crawlRun          CrawlRun      @relation(fields: [crawlRunId], references: [id])
  website           Website       @relation(fields: [websiteId], references: [id])
  parentPage        CrawledPage?  @relation("CrawledPageTree", fields: [parentPageId], references: [id])
  childPages        CrawledPage[] @relation("CrawledPageTree")

  @@unique([crawlRunId, url])
  @@index([websiteId])
  @@index([parentPageId])
  @@map("crawled_pages")
}

/// A login for a website - what the crawler types into the website's login
/// form when a crawl is started "as" this credential. Belongs to exactly one
/// website; a website can have any number. Soft deleted on its own or
/// together with its website. A soft-deleted credential stays linked to the
/// crawl runs that used it, so their history still names it.
///
/// `name` and `description` are the user's own label for it (the description
/// is optional). `username` is stored as typed.
///
/// The password is NEVER stored in plain text and is NEVER sent back by the
/// API. `encryptedPassword` holds it AES-256-GCM encrypted with the server's
/// `CREDENTIAL_ENCRYPTION_KEY`, as `iv.authTag.ciphertext` (each part base64)
/// - see `server/utils/credentialEncryption.ts`. It is encrypted rather than
/// hashed because the crawler has to type the real password; changing or
/// losing the key makes every saved password unreadable.
///
/// Logging in: the crawler opens the login page - the credential's own
/// `loginUrl` when it has one, otherwise its website's `loginUrl` (null here
/// means "inherit") - finds the username field, the password field, and the
/// submit button on its own, fills them in, and submits. The three optional selectors are CSS selectors that replace that
/// guess, one field at a time, for forms the guess gets wrong.
model Credential {
  id                String     @id @default(cuid())
  websiteId         String
  name              String
  description       String?
  username          String
  encryptedPassword String
  loginUrl          String?
  usernameSelector  String?
  passwordSelector  String?
  submitSelector    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  website           Website    @relation(fields: [websiteId], references: [id])
  crawlRuns         CrawlRun[]

  @@index([websiteId])
  @@map("credentials")
}
