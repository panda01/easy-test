# Copy to .env.local and fill in machine-specific values.
# .env holds committed defaults; .env.local overrides them and is gitignored.

# TCP port the Express API binds to. Required - server/utils/resolveServerPort.ts
# throws if it is missing or not a valid port.
SERVER_PORT=3010

# TCP port the Vite dev server binds to (strictPort: true, so it never drifts).
# Required - vite.config.ts throws if it is missing.
VITE_PORT=5180

# PostgreSQL connection string. Read by prisma.config.ts (for the CLI) and by
# server/services/dbService.ts (for the runtime PrismaPg adapter).
# Local Homebrew Postgres with trust auth needs no password:
#   postgresql://<os-user>@localhost:5432/easy_test_dev?schema=public
DATABASE_URL=postgresql://USER@localhost:5432/easy_test_dev?schema=public
