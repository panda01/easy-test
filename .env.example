# Copy to .env.local and fill in machine-specific values.
# .env holds committed defaults; .env.local overrides them and is gitignored.

# TCP port the Express API binds to. Required - server/utils/resolveServerPort.ts
# throws if it is missing or not a valid port.
SERVER_PORT=3010

# TCP port the Vite dev server binds to (strictPort: true, so it never drifts).
# Required - vite.config.ts throws if it is missing.
VITE_PORT=5180

# PostgreSQL connection string. Read by prisma.config.ts (for the CLI) and by
# server/services/dbService.ts (for the runtime PrismaPg adapter).
# Local Homebrew Postgres with trust auth needs no password:
#   postgresql://<os-user>@localhost:5432/easy_test_dev?schema=public
DATABASE_URL=postgresql://USER@localhost:5432/easy_test_dev?schema=public

# Directory the Playwright controller writes screenshot PNGs to and serves them
# from. Required - server/utils/resolveScreenshotDirectory.ts throws at startup
# if it is missing or empty. A relative path resolves against the project root
# (the directory `npm run dev` is started from); an absolute path is used as
# is. `~` is NOT expanded - write the absolute path instead. The directory is
# created on the first screenshot. The default `screenshots` is gitignored; if
# you point this somewhere else inside the repo, gitignore that location too.
SCREENSHOT_DIR=screenshots

# Directory each "Run script" writes into: one folder per run holding the
# generated script.mjs and, when the script fails, its failure.png (served back
# to the UI). Required - server/utils/resolveActionScriptDirectory.ts throws at
# startup if it is missing, empty, or OUTSIDE the project folder. It must be
# inside the project because generated scripts `import ... from 'playwright'`,
# and Node resolves that by walking up from the script file to this project's
# node_modules. A relative path resolves against the project root. The default
# `action-scripts` is gitignored.
ACTION_SCRIPT_DIR=action-scripts

# Anthropic API key used by "Convert to script" (Claude turns an action into a
# Playwright script). SECRET - put the real key ONLY in .env.local, never in
# .env. Optional for boot: without it the server starts normally and the
# convert endpoint answers 503 with an explanation.
ANTHROPIC_API_KEY=
