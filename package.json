{
  "name": "easy-test",
  "version": "1.0.0",
  "description": "Express + React/Vite + Prisma/PostgreSQL development scaffold",
  "type": "module",
  "private": true,
  "engines": {
    "node": "=25.4.0"
  },
  "main": "server/server.ts",
  "scripts": {
    "dev": "tsx watch server/server.ts 2>&1 | sed -l 's/^/[server] /' & vite 2>&1 | sed -l 's/^/[vite] /'",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "dev:claude": "npm run dev 2>&1 & DEV_PID=$!; sleep 5; kill $DEV_PID 2>/dev/null; wait $DEV_PID 2>/dev/null; echo \"Dev server exited\"",
    "stop-dev": "./stop-dev.sh",
    "build": "vite build",
    "postinstall": "prisma generate && prisma db push",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "npx eslint server",
    "tsc": "tsc --project tsconfig.server.json",
    "tsc:client": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.8",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.2",
    "prisma": "^7.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
