{
  "name": "easy-test",
  "version": "1.0.0",
  "description": "Express + React/Vite + Prisma/PostgreSQL development scaffold",
  "type": "module",
  "private": true,
  "engines": {
    "node": "=25.4.0"
  },
  "main": "server/server.ts",
  "scripts": {
    "dev": "tsx watch server/server.ts 2>&1 | sed -l 's/^/[server] /' & vite 2>&1 | sed -l 's/^/[vite] /'",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "dev:claude": "npm run dev 2>&1 & DEV_PID=$!; sleep 5; kill $DEV_PID 2>/dev/null; wait $DEV_PID 2>/dev/null; echo \"Dev server exited\"",
    "stop-dev": "./stop-dev.sh",
    "build": "vite build",
    "build:server": "rm -rf dist-server && tsc --project tsconfig.server.json && cp -R server/prompts dist-server/server/prompts",
    "build:prod": "npm run build && npm run build:server",
    "start": "npm run build:prod && pm2 start ecosystem.config.json --env production",
    "stop": "pm2 stop easy-test",
    "restart": "pm2 restart easy-test",
    "logs": "pm2 logs easy-test",
    "postinstall": "prisma generate && prisma db push && playwright install --with-deps chromium",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "npx eslint server src",
    "tsc": "tsc --project tsconfig.server.json",
    "tsc:client": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.8",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "playwright": "^1.58.2",
    "pm2": "^7.0.4",
    "prisma": "^7.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "eslint-plugin-jsdoc": "^65.0.2",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
