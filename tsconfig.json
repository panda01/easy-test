{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts", "eslint.config.ts"],
  "exclude": ["node_modules", "dist", "dist-server", "server/generated"]
}
